CREATE TABLE segment (
    id TEXT NOT NULL PRIMARY KEY,
    recordingId TEXT NOT NULL,
    windowIndex INTEGER NOT NULL,
    startMs INTEGER NOT NULL,
    endMs INTEGER NOT NULL,
    text TEXT NOT NULL,
    editedText TEXT
);

selectForRecording:
SELECT * FROM segment WHERE recordingId = ? ORDER BY windowIndex ASC, startMs ASC;

insert:
INSERT INTO segment(id, recordingId, windowIndex, startMs, endMs, text, editedText)
VALUES (?, ?, ?, ?, ?, ?, ?);

editText:
UPDATE segment SET editedText = ? WHERE id = ?;

deleteForRecording:
DELETE FROM segment WHERE recordingId = ?;
