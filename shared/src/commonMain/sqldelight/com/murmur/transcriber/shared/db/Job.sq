CREATE TABLE job (
    id TEXT NOT NULL PRIMARY KEY,
    recordingId TEXT NOT NULL,
    modelId TEXT NOT NULL,
    language TEXT,
    status TEXT NOT NULL,
    windowsTotal INTEGER NOT NULL,
    windowsDone INTEGER NOT NULL,
    startedAt INTEGER NOT NULL,
    finishedAt INTEGER,
    error TEXT
);

selectLatestForRecording:
SELECT * FROM job WHERE recordingId = ? ORDER BY startedAt DESC LIMIT 1;

selectById:
SELECT * FROM job WHERE id = ?;

insert:
INSERT INTO job(id, recordingId, modelId, language, status, windowsTotal, windowsDone, startedAt, finishedAt, error)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProgress:
UPDATE job SET windowsDone = ? WHERE id = ?;

updateStatus:
UPDATE job SET status = ?, finishedAt = ?, error = ? WHERE id = ?;

deleteForRecording:
DELETE FROM job WHERE recordingId = ?;
