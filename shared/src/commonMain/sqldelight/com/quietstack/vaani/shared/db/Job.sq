CREATE TABLE job (
    id TEXT NOT NULL PRIMARY KEY,
    recordingId TEXT NOT NULL,
    modelId TEXT NOT NULL,
    language TEXT,
    status TEXT NOT NULL,
    windowsTotal INTEGER NOT NULL,
    windowsDone INTEGER NOT NULL,
    startedAt INTEGER NOT NULL,
    finishedAt INTEGER,
    error TEXT
);

selectLatestForRecording:
SELECT * FROM job WHERE recordingId = ? ORDER BY startedAt DESC LIMIT 1;

selectById:
SELECT * FROM job WHERE id = ?;

insert:
INSERT INTO job(id, recordingId, modelId, language, status, windowsTotal, windowsDone, startedAt, finishedAt, error)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProgress:
UPDATE job SET windowsDone = ? WHERE id = ?;

updateStatus:
UPDATE job SET status = ?, finishedAt = ?, error = ? WHERE id = ?;

deleteForRecording:
DELETE FROM job WHERE recordingId = ?;

-- A job stuck QUEUED/RUNNING only means the process that owned it (a
-- foreground service) died before finishing — nothing can still be running
-- once a fresh app process starts. Run at every app start (see
-- CleanupOrphanedRecordingsUseCase) so those don't show a permanent spinner.
failAllRunning:
UPDATE job SET status = 'FAILED', finishedAt = ?, error = 'Interrupted' WHERE status IN ('QUEUED', 'RUNNING');
